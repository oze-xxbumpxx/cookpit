{
  "name": "cookpit",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,mjs,cjs,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,mjs,cjs,yml,yaml}\"",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:harness": "node --test .claude/tests/*.test.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "lefthook": "^1.11.0",
    "prettier": "^3.5.3",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "esbuild@<=0.24.2": ">=0.25.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "js-yaml@>=4.0.0 <=4.1.1": ">=4.2.0",
      "@babel/core@<=7.29.0": ">=7.29.6 <8.0.0",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7",
      "fast-uri@<3.1.4": ">=3.1.4 <4",
      "sharp@<0.35.0": ">=0.35.0"
    }
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.4"
}
