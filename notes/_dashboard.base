filters:
  and:
    - file.inFolder("notes")
    - file.ext == "md"
    - file.name != "README"
properties:
  status:
    displayName: 状態
  created:
    displayName: 作成日
  file.name:
    displayName: メモ
views:
  - type: table
    name: 未昇格メモ
    filters:
      and:
        - status != "promoted"
    order:
      - file.name
      - status
      - created
  - type: table
    name: 全メモ
    order:
      - file.name
      - status
      - created
