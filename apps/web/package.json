    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "happy-dom": "^17.6.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.0",
    "@electric-sql/pglite": "^0.2.17"
