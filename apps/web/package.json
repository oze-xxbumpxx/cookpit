    "dev:pglite": "node scripts/setup-pglite-dev.mjs && DATABASE_URL=pglite://.pglite-dev next dev",
    "db:seed:pglite": "node scripts/setup-pglite-dev.mjs --fresh"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hono/zod-validator": "^0.8.0",
    "@neondatabase/serverless": "^1.1.0",
    "@serwist/next": "^9.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "serwist": "^9.5.11",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
